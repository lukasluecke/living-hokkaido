{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "living-hokkaido",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Museum captures (Omusha splat), never in Git (vendor/README.md). The
  // bucket must exist before a deploy. Without MUSEUM_ASSET_PASSWORD or the
  // object, the diorama shows its spot list only.
  "r2_buckets": [
    { "binding": "MUSEUM_ASSETS", "bucket_name": "living-hokkaido-museum" }
  ],
  // Secrets (set with `wrangler secret put`): LLM_API_KEY, optional ELEVENLABS_API_KEY,
  // MUSEUM_ASSET_PASSWORD (demo password for museum captures), optional
  // ORCAROUTER_API_KEY (ingestion guard) and LINKUP_API_KEY (source research).
  "vars": { "LLM_PROVIDER": "carbonforge" }
}
