# No keys required. Without keys every provider is an explicit mock.
# Server-only keys. Never prefix them with NEXT_PUBLIC_.

# Curator voice memories (docs/VOICE-MEMORIES.md). Server only, never NEXT_PUBLIC_.
# No key = offline mock. VOICE_MEMORY_PROVIDER=mock forces the mock.
ELEVENLABS_API_KEY=
VOICE_MEMORY_PROVIDER=
# ELEVENLABS_STT_MODEL=scribe_v2

# Ask the owl (docs/ASK.md). Server only, never NEXT_PUBLIC_.
# LLM_PROVIDER: zai | carbonforge | openai-compatible | none
# No key = scripted answers (keyword match, no AI).
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL=glm-5.3-flash
# LLM_BASE_URL=https://api.z.ai/api/paas/v4

# Museum captures (the Omusha splat, vendor/README.md). Server only.
# No password = the capture is shut for everybody (the spot list still works).
# In dev, put files in .museum-assets/ (git-ignored).
MUSEUM_ASSET_PASSWORD=
